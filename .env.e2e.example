# Dedicated Supabase test project. Apply supabase/migrations and supabase/seed.sql first.
# Copy to .env.e2e.local and fill credentials there; never commit secrets.
E2E_DATABASE_KIND=test
E2E_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
E2E_BASE_URL=http://localhost:3300
APP_BASE_URL=http://localhost:3300
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_ENV=test
RELEASE_ENVIRONMENT=test
TEST_TOOLS_ENABLED=true
TEST_SUPABASE_URL=
TEST_SUPABASE_PROJECT_ID=
PRODUCTION_SUPABASE_URL=
PRODUCTION_SERVICE_KEY_SHA256=
PRODUCTION_SESSION_SECRET_SHA256=
TEST_TOOLS_GATE_SECRET=
TEST_ACCOUNT_PASSWORD=
SESSION_HASH_PEPPER=
API_KEY_PEPPER=
INTEGRATION_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=
INTEGRATION_WORKER_SECRET=
OPERATIONS_CRON_SECRET=

# Staging additionally requires APP_ENV=staging, HTTPS and an access gate.
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD=

# Optional custom browser executable.
# UI_QA_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
