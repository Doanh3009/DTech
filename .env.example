# Required for browser-safe Supabase access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Application defaults.
APP_NAME="Hệ thống nội bộ Châu Tuấn"
APP_TIMEZONE="Asia/Ho_Chi_Minh"
APP_BASE_URL="http://localhost:3000"

# Optional integration foundation.
WEBHOOK_SIGNING_SECRET=
API_KEY_PEPPER=
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_WORKER_SECRET=
OPERATIONS_CRON_SECRET=
SESSION_HASH_PEPPER=
LOG_LEVEL="info"

# Release/operations metadata. BACKUP_LAST_VERIFIED_AT is populated only after a real restore drill.
RELEASE_SHA="development"
RELEASE_ENVIRONMENT="development"
BACKUP_LAST_VERIFIED_AT=
